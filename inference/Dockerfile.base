FROM --platform=${TARGETPLATFORM} ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt update && apt install -y \
    wget \
    curl \
    git \
    build-essential \
    libffi-dev \
    libtiff-dev \
    python3 \
    python3-pip \
    python-is-python3 \
    python3-venv \
    jq \
    locales \
    locales-all \
    tzdata \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Download and install Miniconda (matches src/dockerfiles.py)
ARG TARGETARCH
RUN if [ "$TARGETARCH" = "arm64" ]; then CONDA_ARCH="aarch64"; else CONDA_ARCH="x86_64"; fi && \
    wget "https://repo.anaconda.com/miniconda/Miniconda3-py311_23.11.0-2-Linux-${CONDA_ARCH}.sh" -O miniconda.sh \
    && bash miniconda.sh -b -p /opt/miniconda3 \
    && rm miniconda.sh
ENV PATH=/opt/miniconda3/bin:$PATH
RUN conda init --all
RUN conda config --append channels conda-forge

RUN adduser --disabled-password --gecos 'agent' agent

ARG TARGETARCH
RUN case "$TARGETARCH" in \
      arm64) OCODE_ARCH="arm64" ;; \
      amd64) OCODE_ARCH="x64" ;; \
      *)     OCODE_ARCH="x64" ;; \
    esac && \
    curl -fsSL "https://github.com/anomalyco/opencode/releases/download/v1.17.9/opencode-linux-${OCODE_ARCH}.tar.gz" \
      -o /tmp/opencode.tar.gz && \
    tar xzf /tmp/opencode.tar.gz -C /usr/local/bin opencode && \
    chmod +x /usr/local/bin/opencode && \
    rm /tmp/opencode.tar.gz

RUN mkdir -p /workspace && chown -R agent:agent /workspace
WORKDIR /workspace
